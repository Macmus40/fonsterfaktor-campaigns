# Copy to .env.local / .env — fill values locally. Never commit real secrets.

# --- Meta Graph API (server-only; connected publish mode) ---
META_PAGE_ID=123456789012345
META_PAGE_ACCESS_TOKEN=EAAB...replace_me
META_IG_USER_ID=17841400000000000
META_TEST_ACCOUNT_LABEL=fonsterfaktor-test-page
META_ALLOW_LIVE_SENDS=false
META_GRAPH_VERSION=v22.0

# --- App ---
# Optional override for absolute campaign links in packages / redirects
APP_ORIGIN=http://localhost:3000

# --- DIN Next / konfigurator event ingest (server-only) ---
# When set, POST /api/events/din-next requires the same value in
# X-FF-Ingest-Secret or Authorization: Bearer …
DIN_NEXT_INGEST_SECRET=replace_me_shared_secret
FF_INGEST_SECRET=

# --- Optional verified platform metrics (analytics) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
