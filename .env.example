# Copy to .env.local — fill locally. Never commit real secrets.

# --- Storage driver ---
# supabase (default) | sqlite (offline prototype only)
STORAGE_DRIVER=supabase

# --- Supabase (separate project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...replace_me
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace_me_server_only

# --- App ---
APP_ORIGIN=http://localhost:3000

# --- DIN Next ingest (public endpoint, shared secret) ---
DIN_NEXT_INGEST_SECRET=replace_me_shared_secret
FF_INGEST_SECRET=

# --- Scheduled publish job (Vercel Cron + local npm run jobs:publish-due) ---
CRON_SECRET=replace_me_cron_secret
# Local only: allow cron route without secret (never in production)
ALLOW_UNAUTHENTICATED_CRON=false
# simulate (default local) | live (Meta connected when configured)
PUBLISH_JOB_MODE=simulate

# --- Meta Graph API (server-only; connected publish mode) ---
META_PAGE_ID=123456789012345
META_PAGE_ACCESS_TOKEN=EAAB...replace_me
META_IG_USER_ID=17841400000000000
META_TEST_ACCOUNT_LABEL=fonsterfaktor-test-page
META_ALLOW_LIVE_SENDS=false
META_GRAPH_VERSION=v22.0

# --- Optional verified platform metrics ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
