# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / tokens / secrets — never commit real values
.env
.env.*
!.env.example
**/secrets/
**/*secret*
**/*token*.json
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite (durable file created at runtime; keep directory)
/data/*.sqlite
/data/*.sqlite-*
/data/*.db
!/data/.gitkeep

# operator uploads from the post studio (local media, not source)
/public/uploads/

# private photos / videos and client data
/private/
/uploads/private/
/client-data/
**/client-uploads/
**/*.private.jpg
**/*.private.jpeg
**/*.private.png
**/*.private.webp
**/*.private.mp4
**/*.private.mov
**/customers/
**/leads-export/
